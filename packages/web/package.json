{
  "name": "@agent-computers/web",
  "version": "0.1.0",
  "description": "The Agent Computers web app's product library: the dashboard, sign-in and consent pages as route modules, their components and client code, the route manifest, the proxy, and the Node server.",
  "bugs": "https://github.com/agent-computers/clutchbox/issues",
  "author": "Agent Computers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-computers/clutchbox.git",
    "directory": "packages/web"
  },
  "private": true,
  "license": "Apache-2.0 AND MIT",
  "type": "module",
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./routes/*": "./src/routes/*.tsx",
    "./deployment": "./src/deployment.tsx",
    "./services": "./src/services.ts",
    "./proxy": "./src/proxy.ts",
    "./node-server": "./src/node-server.ts",
    "./next-config.mjs": "./next-config.mjs",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@agent-computers/api": "workspace:*",
    "@agent-computers/capture": "workspace:*",
    "@agent-computers/server": "workspace:*",
    "@agent-computers/ui": "workspace:*",
    "@better-auth-ui/core": "1.7.30",
    "@better-auth-ui/react": "1.7.30",
    "@better-auth/oauth-provider": "1.7.11",
    "@better-auth/utils": "0.5.0",
    "@novnc/novnc": "1.7.0",
    "@tanstack/react-query": "5.104.3",
    "better-auth": "1.7.11",
    "lucide-react": "1.59.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  },
  "peerDependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
