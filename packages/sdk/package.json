    "stagehand",
    "cdp",
    "ai-agents",
    "browser-automation",
    "logged-in",
    "session"
  ],
  "homepage": "https://www.clutchbox.dev",
  "bugs": "https://github.com/clutchbox-hq/clutchbox/issues",
  "author": "Clutchbox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clutchbox-hq/clutchbox.git",
    "directory": "packages/sdk"
  },
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@clutchbox/capture": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "playwright-core": "1.64.0"
  }
