{
  "name": "@agent-computers/ui",
  "version": "0.1.0",
  "description": "The Agent Computers web app's design system: shadcn components on Base UI, the theme, and the fonts.",
  "homepage": "https://www.agent-computers.com",
  "bugs": "https://github.com/agent-computers/agent-computers/issues",
  "author": "Agent Computers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-computers/agent-computers.git",
    "directory": "packages/ui"
  },
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./fonts/*": "./src/fonts/*",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.59.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
