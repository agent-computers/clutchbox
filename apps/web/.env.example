# development, or production for a real deployment (which then requires E2B_API_KEY).
APP_ENV=development
# Postgres. The pooled URL for the app; the unpooled one, if your host has both, for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# This app's public origin; sign-in, OAuth, and the extension build use it.
BETTER_AUTH_URL=http://localhost:3000
# At least 32 random characters (`openssl rand -base64 32`).
BETTER_AUTH_SECRET=
# A Google OAuth client for sign-in, with BETTER_AUTH_URL/api/auth/callback/google as its redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Real computers on this key's E2B team. Without it, development uses an in-memory fake; production requires it.
E2B_API_KEY=
# Optional: the E2B template computers start from (default agent-computers-desktop), built by `bun run computer:template`.
E2B_COMPUTER_TEMPLATE=
# Browser sync: base64 of 32 random bytes (`openssl rand -base64 32`). Without it, uploads answer 503.
CAPTURE_ENCRYPTION_KEY=
# Comma-separated extension origins allowed to sign in and upload: the manual build's pinned ID.
EXTENSION_ORIGINS=chrome-extension://jpkiadcbmdldnjmfdllbiioieajicacg
# The Node server (`bun run start`): true applies pending migrations before it listens.
MIGRATE_ON_START=
# true behind a reverse proxy that overwrites X-Forwarded-For with the client's address.
TRUST_PROXY=
# The address the Node server listens on (default 0.0.0.0:3000).
HOST=
PORT=
