# development, or production for a real deployment (which then requires E2B_API_KEY).
APP_ENV=development
# Postgres. The pooled URL for the app; the unpooled one, if your host has both, for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# This app's public origin; sign-in, OAuth, and the extension build use it.
BETTER_AUTH_URL=http://localhost:3000
# At least 32 random characters (`openssl rand -base64 32`).
BETTER_AUTH_SECRET=
# Sign-in: set at least one method; the server refuses to start with none, or with one partly set.
# Google: an OAuth web client with BETTER_AUTH_URL/api/auth/callback/google as its redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: an OAuth app with BETTER_AUTH_URL/api/auth/callback/github as its callback URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Company SSO over OIDC: the issuer (or its discovery document's URL), and a client with
# BETTER_AUTH_URL/api/auth/callback/oidc as its redirect URI. Optional: the button's name, such as Acme SSO.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=
# Email links: an smtp:// or smtps:// URL with credentials (smtps://user:password@smtp.example.com), and the sender.
SMTP_URL=
SMTP_FROM=
# Real computers on this key's E2B team. Without it, development uses an in-memory fake; production requires it.
E2B_API_KEY=
# Optional: the E2B template computers start from (default agent-computers-desktop: your team's own, built by
# `bun run computer:template`, or else the public one Clutchbox publishes).
E2B_COMPUTER_TEMPLATE=
# Browser sync: base64 of 32 random bytes (`openssl rand -base64 32`). Without it, uploads answer 503.
CAPTURE_ENCRYPTION_KEY=
# Comma-separated extension origins allowed to sign in and upload: the manual build's pinned ID, and the Chrome Web
# Store build's, which connects to this server when a member enters its address.
EXTENSION_ORIGINS=chrome-extension://jpkiadcbmdldnjmfdllbiioieajicacg,chrome-extension://bjmfpnkjkdkfimdfgbgepmdgdnodpmmi
# Optional: other agents allowed to connect over MCP, besides Claude, Claude Code, ChatGPT, and Codex: the client_id
# URLs of their client metadata documents, comma separated, each exact or a prefix ending with a slash.
AGENT_CLIENT_URLS=
# The Node server (`bun run start`): true applies pending migrations before it listens.
MIGRATE_ON_START=
# true behind a reverse proxy that overwrites X-Forwarded-For with the client's address.
TRUST_PROXY=
# The address the Node server listens on (default 0.0.0.0:3000).
HOST=
PORT=
