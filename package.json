{
  "name": "agent-computers",
  "private": true,
  "description": "Agents that work signed in: sync the sites you choose from your browser into the browsers your AI agents use.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-computers/agent-computers.git"
  },
  "homepage": "https://www.agent-computers.com",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:extension": "bun run --cwd apps/extension dev",
    "build:extension": "bun run --cwd apps/extension build",
    "zip:manual": "node --import tsx scripts/zip-manual.ts",
    "check:extension-version": "node --import tsx scripts/check-extension-version.ts",
    "check:extension": "node --import tsx scripts/check-extension.ts",
    "typecheck": "bun --filter \"*\" typecheck && tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "render:readme-images": "node --import tsx scripts/render-readme-images.ts",
    "db:generate": "bun run --cwd packages/server drizzle-kit generate",
    "db:migrate": "node --import tsx packages/server/src/migrate.ts",
    "test:accounts": "vitest run packages/server/src/accounts.test.ts",
    "test:computers": "vitest run packages/server/src/computers.test.ts",
    "test:captures": "vitest run packages/server/src/captures.test.ts",
    "test:mcp": "vitest run packages/api/src/mcp.test.ts",
    "computer:template": "node --conditions=react-server --import tsx packages/server/scripts/build-computer-template.ts",
    "computer:smoke": "node --conditions=react-server --import tsx packages/server/scripts/smoke-computer.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "build:web": "bun run --cwd apps/web build",
    "start:web": "bun run --cwd apps/web start",
    "generate-routes": "node --import tsx packages/web/scripts/generate-routes.ts --app apps/web --group 'sign-in=(auth),consent=(auth),join=(auth),invitation=(auth)'"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electric-sql/pglite": "0.5.9",
    "@types/node": "24.19.2",
    "fflate": "0.8.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "playwright-core": "1.64.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
