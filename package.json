{
  "name": "agent-computers",
  "private": true,
  "description": "Agents that work signed in: sync the sites you choose from your browser into the browsers your AI agents use.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-computers/agent-computers.git"
  },
  "homepage": "https://www.agent-computers.com",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:extension": "bun run --cwd apps/extension dev",
    "build:extension": "bun run --cwd apps/extension build",
    "zip:manual": "node --import tsx scripts/zip-manual.ts",
    "check:extension-version": "node --import tsx scripts/check-extension-version.ts",
    "typecheck": "bun --filter \"*\" typecheck && tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "render:readme-images": "node --import tsx scripts/render-readme-images.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "fflate": "0.8.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "playwright-core": "1.64.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
